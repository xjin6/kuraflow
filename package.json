{
  "name": "kuraflow-kitchen-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/model.test.mjs",
    "start": "node scripts/dev/server.mjs",
    "setup:local": "node scripts/dev/setup-local-data.mjs",
    "build:cloud": "node scripts/build/build-cloud.mjs",
    "dev:cloud": "wrangler dev --local --var LOCAL_TEST:1 --port 8787",
    "test:backend": "node --test tests/backend/*.test.mjs",
    "deploy:check": "npm run build:cloud && wrangler deploy --dry-run",
    "dev:accounts": "npm run build:cloud && node scripts/dev/dev-accounts.mjs",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "test:flow": "node --test tests/flow/*.test.mjs tests/frontend/flow-ui.test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "fflate": "^0.8.3",
    "fonteditor-core": "^2.6.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@github/copilot-sdk": "^1.0.22",
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "wrangler": "^4.146.0"
  }
}
