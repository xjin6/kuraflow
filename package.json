{
  "name": "kuraflow-kitchen-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test-model.mjs",
    "start": "node server.mjs",
    "setup:local": "node scripts/setup-local-data.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "dev:cloud": "wrangler dev --local --var LOCAL_TEST:1 --port 8787",
    "test:backend": "node --test backend/*.test.mjs",
    "deploy:check": "npm run build:cloud && wrangler deploy --dry-run",
    "dev:accounts": "npm run build:cloud && node scripts/dev-accounts.mjs",
    "test:frontend": "node --test frontend/*.test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "wrangler": "^4.146.0"
  }
}
